# ==============================================================================
# InDiiServe Nova Sonic Voice Agent — Environment Configuration Template
# ==============================================================================
# COPY this file to .env and fill in your actual production/staging values.
# NEVER commit real API keys, tokens, or passwords to git!
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development
PORT=8000
DEMO_MODE=false
HOSPITAL_ID=apollo_metro

# ------------------------------------------------------------------------------
# AWS Credentials & Bedrock Configuration
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
ANALYTICS_MODEL_ID=amazon.nova-sonic-v1:0
NOVA_VOICE_ID=matthew

# ------------------------------------------------------------------------------
# Exotel Telephony Integration
# ------------------------------------------------------------------------------
EXOTEL_API_KEY=YOUR_EXOTEL_API_KEY
EXOTEL_API_TOKEN=YOUR_EXOTEL_API_TOKEN
EXOTEL_SID=YOUR_EXOTEL_SID
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_FROM_NUMBER=080XXXXXXXX
EXOTEL_APP_ID=YOUR_EXOTEL_APP_ID
SIP_ENDPOINT=sip:agent@voice.indiiserve.ai

# WebSocket Authentication Secret for Exotel Media Streams (HMAC-SHA256)
EXOTEL_WS_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Public WebSocket URL reachable by Exotel (e.g. wss://voice.indiiserve.ai:8000/media-stream)
WS_PUBLIC_URL=wss://voice.indiiserve.ai/media-stream

# ------------------------------------------------------------------------------
# Security, Tokens & Administrative Auth
# ------------------------------------------------------------------------------
# 32-byte Fernet key for encrypting patient PII in storage/transit
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=YOUR_FERNET_32_BYTE_ENCRYPTION_KEY

# Health check endpoint token
HEALTH_CHECK_TOKEN=YOUR_HEALTH_CHECK_BEARER_TOKEN

# Admin API Key for external webhook integrations
ADMIN_API_KEY=YOUR_ADMIN_API_KEY

# JWT Secret for Admin Portal authentication (Required in production, min 32 chars)
ADMIN_JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars

# Password hash for initial admin user seed (bcrypt)
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_STRONG_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Explicit CORS Origins (comma-separated, do NOT use wildcard * in production)
CORS_ORIGINS=http://localhost:5173,https://voice.indiiserve.ai

# Optional: Allow staging fallback passwords in development only ('true' or 'false')
ALLOW_DEV_PASSWORDS=false

# ------------------------------------------------------------------------------
# Database & Storage
# ------------------------------------------------------------------------------
DYNAMODB_TABLE_NAME=indiiserve_analytics
KB_ID=YOUR_BEDROCK_KNOWLEDGE_BASE_ID
KB_REGION=us-east-1
MEMORY_ID=YOUR_BEDROCK_MEMORY_ID
MEMORY_REGION=us-east-1

# Optional Relational DB (if using PostgreSQL/MySQL RDS alongside DynamoDB)
RDS_HOSTNAME=localhost
RDS_PORT=5432
RDS_USERNAME=postgres
RDS_DB_NAME=indiiserve

# Google Sheets Integration (Optional fallback for bookings)
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Cache tuning
FAISS_MAX_ENTRIES=5000
FAISS_KEEP_ENTRIES=2500
